# Only runtime files are shipped.  Everything below is either development
# material or configuration that the user must provide.
prune ai-changes
prune check
prune learn
prune recycle
prune jobmanager/demo

recursive-include catagent *.md *.html
recursive-include jobmanager *.md
recursive-include skills *
recursive-include tools *
recursive-include libs *

exclude jobmanager/jobmanager_config.json
global-exclude .env .env.*
global-exclude *.py[cod]
global-exclude __pycache__/*
