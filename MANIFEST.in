# Only runtime files are shipped.  Everything below is either development
# material or configuration that the user must provide.
recursive-include catagent *

# Prune after the recursive include: later rules win in MANIFEST.in.
prune catagent/jobmanager/demo
prune ai-changes
prune check
prune learn
prune recycle

exclude catagent/jobmanager/jobmanager_config.json
global-exclude .env .env.*
global-exclude *.py[cod]
global-exclude __pycache__/*
