job.json\nrun.sh\nrun_opt.py\nfrom ase.io import read, write\nfrom pathlib import Path \nimport numpy as np \nfrom random import shuffle\n\nfrom ase.mep import NEB \n\ndef get_structures_distance(atoms1, atoms2)->float:\n    if len(atoms1)!= len(atoms2):\n        return -1.0\n    cell1 = atoms1.get_cell()\n    cell2 = atoms2.get_cell()\n    if not np.all(np.isclose(cell1, cell2)):\n        return -1.0\n    frac1 = atoms1.get_scaled_positions()\n    frac2 = atoms2.get_scaled_positions()\n    diff_frac = frac1 - frac2\n    diff_frac[diff_frac > 0.5] -= 1.0\n    diff_frac[diff_frac < -0.5] += 1.0\n    diff_cart = np.matmul(diff_frac, cell1)\n    return np.sum(diff_cart**2.0) ** 0.5\n\nini_poscar_list = []\nfor f_poscar in Path(\"./23308374/poscars/\").rglob(\"POSCAR*\"):\n    name = f_poscar.name \n    if \"ini\" in name:\n        ini_poscar_list.append(f_poscar)\n        \ni_neb = 0\ni_opt = 0\nfor ini_poscar in ini_poscar_list:\n    print(str(ini_poscar))\n    a, b, c, d = ini_poscar.name.split('_')\n\n    num = d.replace('ini', '')\n    if len(num) == 0:\n      num = 0\n    else:\n      num = int(num)\n    name=c+'_'+str(num)\n\n\n    fin_poscar = ini_poscar.parent / ini_poscar.name.replace(\"ini\", \"fin\")\n    ini = read(ini_poscar)\n    fin = read(fin_poscar)\n    d = get_structures_distance(ini, fin)\n    if d < 8.0:\n        n_images = int(d/0.6) - 1\n        images = [ini]\n        images += [ini.copy() for i in range(n_images)]\n        images.append(fin)\n        neb = NEB(images=images, method='improvedtangent')\n        try:\n            neb.interpolate(method='idpp')\n        except Exception as e:\n            print(f\"Error: {ini_poscar} and {fin_poscar} is the same.\")\n            #ini_traj = read(str(ini_poscar).replace(\"POSCAR_opt_\", \"\").replace(\"opt\", \"trajs\") + \".traj\", index=\":\")\n            #fin_traj = read(str(fin_poscar).replace(\"POSCAR_opt_\", \"\").replace(\"opt\", \"trajs\") + \".traj\", index=\":\")\n            #shuffle(ini